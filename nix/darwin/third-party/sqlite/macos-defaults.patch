+    appleDefensive = 1;
+  }else if( strcmp(zName, "sqlite3")==0 || strcmp(zName, "testfixture")==0 ){
+    appleDefensive = 0;
+  }else{
+    appleDefensive = dyld_program_sdk_at_least(dyld_fall_2020_os_versions);
+  }
+}
